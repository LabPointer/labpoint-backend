{
  "name": "app",
  "version": "0.0.1",
  "description": "Backend TypeScript framework with End-to-End Type Safety",
  "license": "MIT",
  "author": "Nathan",
  "type": "module",
  "main": "build/index.js",
  "private": true,
  "prisma": {
    "schema": "prisma/schema"
  },
  "scripts": {
    "check": "tsc --noEmit && echo ✔ Ok",
    "build": "tsup",
    "auth:generate": "bunx auth@latest generate",
    "prisma:dev": "bunx prisma dev",
    "prisma:dev:update": "bunx prisma migrate dev --name init && bunx prisma generate",
    "prisma:studio": "bunx prisma studio",
    "dev": "bun --env-file=.env ./src/index.ts",
    "watch": "bun --watch --env-file=.env ./src/index.ts",
    "start": "bun --env-file=.env.prod .",
    "start:dev": "bun --env-file=.env.dev ."
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "latest",
    "@elysiajs/openapi": "latest",
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "latest",
    "better-auth": "latest",
    "chalk": "latest",
    "dotenvy": "latest",
    "elysia": "latest",
    "pg": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@prisma/config": "latest",
    "bun-types": "latest",
    "dotenv": "latest",
    "prisma": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "imports": {
    "#api": [
      "./build/api/index.js"
    ],
    "#database": [
      "./build/api/database.js"
    ],
    "#env": [
      "./build/env.js"
    ],
    "#index": [
      "./build/index.js"
    ],
    "#functions": [
      "./build/functions/index.js"
    ]
  },
  "module": "src/index.js"
}
