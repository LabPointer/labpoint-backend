{
  "name": "app",
  "version": "0.0.1",
  "description": "Backend TypeScript framework with End-to-End Type Safety",
  "license": "MIT",
  "author": "Nathan",
  "type": "module",
  "main": "build/index.js",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit && echo ✔ Ok",
    "build": "tsup",
    "auth:generate": "bunx --bun auth@latest generate --config ./src/api/auth.ts",
    "db:generate": "bunx --bun --env-file=.env drizzle-kit generate",
    "db:migrate": "bunx --bun --env-file=.env drizzle-kit migrate",
    "db:upsert": "bun --env-file=.env ./src/seed.ts",
    "dev": "bun --env-file=.env ./src/index.ts",
    "watch": "bun --watch --env-file=.env ./src/index.ts",
    "start": "bun --env-file=.env.prod .",
    "start:dev": "bun --env-file=.env.dev ."
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "latest",
    "@elysiajs/openapi": "latest",
    "@neondatabase/serverless": "latest",
    "better-auth": "latest",
    "chalk": "latest",
    "dotenvy": "latest",
    "drizzle-orm": "latest",
    "elysia": "latest",
    "pg": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "bun-types": "latest",
    "dotenv": "latest",
    "drizzle-kit": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "imports": {
    "#api": [
      "./build/api/index.js"
    ],
    "#db": [
      "./build/db/index.js"
    ],
    "#env": [
      "./build/env.js"
    ],
    "#index": [
      "./build/index.js"
    ],
    "#functions": [
      "./build/functions/index.js"
    ]
  },
  "module": "src/index.js"
}
