<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Email</RootNamespace>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MailKit" Version="5.0.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Templates\**" />
        <Content Include="Templates\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <!-- Core: AppDbContext (PostgreSQL ou SQLite), fila de e-mails, tokens e relógio de Brasília. -->
        <ProjectReference Include="..\Config\Config.csproj" />
        <ProjectReference Include="..\Core\Core.csproj" />
    </ItemGroup>
</Project>
