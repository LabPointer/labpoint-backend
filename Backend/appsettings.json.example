{
  // Base do Backend (vale em todos os ambientes). appsettings.{Ambiente}.json sobrescreve só o que muda.

  // Banco de dados: "PostgreSql" (usa ConnectionStrings:DbConnection) ou "Sqlite" (usa ConnectionStrings:SqliteConnection).
  // O serviço de e-mail (projeto Email) precisa apontar para o mesmo banco.
  "Database": {
    "Provider": "PostgreSql",
    // Pasta do arquivo do SQLite (vazio = pasta atual do app). Na Discloud: "/home/discloud".
    "SqliteDirectory": ""
  },
  "ConnectionStrings": {
    "DbConnection": "Host=<endpoint>.neon.tech;Port=5432;Database=<database>;Username=<usuario>;Password=<senha>;SSL Mode=Require;Timeout=30",
    "SqliteConnection": "Data Source=labpoint.db"
  },
  "Frontend": {
    "Url": "https://labpoint.vercel.app"
  },
  "Cors": {
    "AllowedOrigins": ["https://labpoint.vercel.app"]
  },
  "Holidays": {
    "State": "GO",
    "Municipal": [
      { "Date": "07-31", "Name": "Aniversário de Anápolis" }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
