{
	"compilerOptions": {
		"types": ["node"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		// Output Options
		"outDir": "./build",
		"rootDir": "./src",

		// Path mapping Options
		"paths": {
			"#api": ["./src/api/index.ts"],
			"#env": ["./src/env.ts"],
			"#functions": ["./src/functions/index.ts"],
			"#db": ["./src/db/index.ts"],
			"#types/*": ["./src/types/*"],
			"#constants": ["./json/constants.json"],
			"#laboratories": ["./json/laboratories.json"],
			"@json/*": ["./json/*"],
			"@/*": ["./src/*"]
		}
	},
	
	// Include and Exclude Options
	"include": ["src", "json"],
	"exclude": ["node_modules"]
}